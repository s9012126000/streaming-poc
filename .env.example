# ---------------------------------------------------------------------------
# 複製成 .env 後填入實際值。.env 已被 .gitignore 排除，不會進 git。
#
# GKE 上這份檔案由 scripts/gcp/07-create-secrets.sh 轉成 K8s Secret：
#   kubectl create secret generic streaming-secrets --from-env-file=.env
# 所以**新增 key 之後要重跑那支腳本**，否則 pod 讀不到。
#
# ⚠️ K8s Secret 在 etcd 裡只是 base64，不是加密。
#    正式環境應該用 Secret Manager，已列在待辦。
# ---------------------------------------------------------------------------

# --- Alpaca（美股，交易時段使用）------------------------------------------
# https://app.alpaca.markets/ → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- MinIO（S3 相容物件儲存，存 Iceberg 的 Parquet 與 Flink checkpoint）----
# 本機隨便填；GKE 上這兩個值同時給 MinIO 自己、Flink、Trino、iceberg-rest。
# 改了要重跑 07-create-secrets.sh 並重啟那四個服務。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Iceberg catalog 的 Postgres 密碼 --------------------------------------
# 產生一組：openssl rand -base64 24 | tr -d '/+=' | head -c 24
#
# 為什麼 catalog 需要一個資料庫：它記錄「哪張表對應哪個 metadata.json」。
# 原本用 image 預設的 in-memory SQLite，重啟就失憶；
# 改成檔案型 SQLite 之後又撐不住兩個 Flink job 同時 commit（SQLITE_BUSY）。
# 完整經過見 doc/updated_plan/week9-decisions.md 坑 1。
CATALOG_DB_PASSWORD=

# --- Discord Bot（推播異常告警）-------------------------------------------
# https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=
# 頻道右鍵 → 複製頻道 ID（需先開啟開發者模式）
DISCORD_CHANNEL_ID=
# 同一支標的的告警冷卻秒數，避免洗版
ALERT_COOLDOWN_SECS=60

# --- Discord Webhook（Alertmanager 用，跟上面的 Bot 是兩回事）--------------
# 伺服器設定 → 整合 → Webhook → 新增
#
# ⚠️ Alertmanager **不展開環境變數**——設定檔裡寫 ${DISCORD_WEBHOOK}
#    只會被當字面字串送出去，Discord 回 404，而日誌只說「通知失敗」。
#    所以 k8s/week9/alertmanager.yaml 用的是 webhook_url_file，
#    把這個值掛成檔案讀進去。
DISCORD_WEBHOOK=

# ---------------------------------------------------------------------------
# ⚠️ ENDPOINT 這個 key 曾經存在於 .env，但 grep 過整個 codebase 沒有任何
#    地方讀它——是早期版本的遺留物。新環境不需要設。
#    留這段註記是因為「看起來像設定、其實沒有作用」的東西最容易在除錯時
#    誤導人（同一份專案裡的 flink-common ConfigMap 也是這個狀況）。
# ---------------------------------------------------------------------------
